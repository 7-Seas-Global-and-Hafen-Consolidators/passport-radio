{
  "version": 16,
  "daily_target": 500,
  "daily_publish_cap": 500,
  "daily_capacity": 700,
  "daily_evaluation_cap": 1200,
  "max_batch": 12,
  "evaluation_scan_per_run": 48,
  "generation_call_budget_per_run": 12,
  "local_zero_key_format": "STORY",
  "local_zero_key_force_batch": 2,
  "local_zero_key_retry_limit": 1,
  "local_zero_key_target_margin_words": 80,
  "local_zero_key_target_window_words": 260,
  "local_zero_key_flash_envelope": {
    "min_sections": 3,
    "max_sections": 5,
    "min_paragraphs_per_section": 2,
    "max_paragraphs_per_section": 4,
    "min_paragraph_chars": 420,
    "max_paragraph_chars": 760,
    "min_closing_chars": 140,
    "max_closing_chars": 360
  },
  "source_firewall_max_chars": 7000,
  "minimum_fact_pack_facts": 2,
  "format_word_range": 650,
  "quality_gate": {
    "mode": "enforce",
    "require_fact_refs": true,
    "require_ptbr": true,
    "anti_copy_window_words": 40,
    "max_paragraph_similarity": 0.60,
    "min_words_for_similarity": 28
  },
  "provider_timeouts": {
    "groq": 30,
    "gemini": 45,
    "openrouter": 60,
    "ollama": 300
  },
  "cooldown_days": 45,
  "ledger_size": 100000,
  "feed_size": 300,
  "model": "auto",
  "web_search": true,
  "max_output_tokens": 9000,
  "api_timeout_seconds": 240,
  "minimum_words": {
    "FLASH": 850,
    "STORY": 1100,
    "MR_NOMAD": 1400,
    "LIVE_SIGNAL": 850
  },
  "public_forbidden_patterns": [
    "segundo a ", "segundo o ", "de acordo com ", "fonte:", "fontes:",
    "publicado originalmente", "publicada originalmente", "em entrevista ao ",
    "em entrevista à ", "em entrevista para ", "according to ", "source:",
    "loudersound.com", "whiplash.net", "rollingstone.com", "billboard.com",
    "nme.com", "kerrang.com", "blabbermouth.net", "loudwire.com",
    "stereogum.com", "pitchfork.com", "consequence.net", "soompi.com",
    "billboard-japan.com", "barks.jp", "natalie.mu", "scmp.com",
    "bandwagon.asia", "rollingstoneindia.com", "scenenoise.com",
    "arabnews.com", "musicinafrica.net", "dancehallmag.com"
  ]
}
